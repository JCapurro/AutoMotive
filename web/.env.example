# Supabase. Local (`npx supabase start` from the repo root; `npx supabase status` prints them):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: /r/<id> click tracking and app_config reads. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app: magic link redirects. Defaults to the request's origin.
SITE_URL=http://127.0.0.1:3000

# The bot's username, for the deep link t.me/<bot>?start=<code> in /app/settings.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
