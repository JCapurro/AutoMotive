# Supabase. Local (`npx supabase start` from the repo root; `npx supabase status` prints them):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: /r/<id> click tracking and app_config reads. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app: magic link redirects. Defaults to the request's origin.
SITE_URL=http://127.0.0.1:3000
# Production domain: SITE_URL=https://www.eseauto.com.ar (canonical host); configure Auth redirects too.

# The bot's username, for the deep link t.me/<bot>?start=<code> in /app/settings.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Where users write about their data (shown in /privacidad and /terminos). Set it before the pilot.
NEXT_PUBLIC_CONTACT_EMAIL=

# Mercado Pago: server only. Keep disabled until migrations, webhook and test checkout pass.
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
CRON_SECRET=
# true only in an isolated test environment with test accounts. Never in production.
MERCADOPAGO_TEST_MODE=false
# Only for the isolated rehearsal: buyer ID shown in Mercado Pago test accounts.
MERCADOPAGO_TEST_BUYER_ID=
