# Read by the Supabase CLI for the env(...) values of supabase/config.toml.
# Copy to supabase/.env (not committed) and restart: npx supabase stop; npx supabase start

# Development
SITE_URL=http://127.0.0.1:3000
AUTH_REDIRECT_URLS=http://127.0.0.1:3000/**
AUTH_EXTERNAL_URL=http://127.0.0.1:54321/auth/v1
SMTP_ENABLED=false
RESEND_API_KEY=unused
EMAIL_FROM_ADDRESS=noreply@example.com

# Pilot (docs/PILOT_SETUP.md), with your domain:
# SITE_URL=https://automotive.tudominio.com.ar
# AUTH_REDIRECT_URLS=https://automotive.tudominio.com.ar/**
# AUTH_EXTERNAL_URL=https://api.automotive.tudominio.com.ar/auth/v1
# SMTP_ENABLED=true
# RESEND_API_KEY=re_...
# EMAIL_FROM_ADDRESS=alertas@tudominio.com.ar

# Own keys, instead of the CLI's demo keys (the same on every machine).
# Generate them with: cd worker; python -m tools.supabase_keys generate
# JWT_SECRET=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
