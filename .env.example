# Legacy Telegram integration. Disabled for the web/email MVP.
TELEGRAM_ENABLED=false
# Telegram bot token from @BotFather. The bot links accounts (/start <code>) and
# answers the alert buttons; searches are created in the web.
TELEGRAM_TOKEN=
# Chat (tu usuario o un grupo) que recibe las alertas operativas: una fuente que
# falla app_config.collector_failure_alert_after veces seguidas (sección 10).
TELEGRAM_ADMIN_CHAT_ID=

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone who chats with the bot.
ALLOWED_USER_IDS=

# How often the crawl loop wakes up to look for due crawl targets. Each
# source's cadence is sources.crawl_interval_seconds in the database.
TICK_INTERVAL_SECONDS=300

# Pause between two targets of the same source (randomized between x/2 and x).
CRAWL_JITTER_SECONDS=8

# Enrichment of matched listings and the daily watchlist check wake up this often.
ENRICH_TICK_SECONDS=300
WATCHLIST_TICK_SECONDS=3600

# Recommended listings whose publication date is older than this are dropped.
# Sources without a reliable publication date use seen_listings + bootstrap.
RECOMMENDED_MAX_AGE_DAYS=15

# Enable listing-location geocoding for radio_km filtering.
# Uses a local city table first, then Nominatim/OpenStreetMap with a Postgres cache.
GEOCODING_ENABLED=1
GEOCODING_USER_AGENT=AutoMotiveAlerts/1.0

# Supabase Postgres. Local `supabase start`:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: the direct connection or the session pooler. With the transaction
# pooler (port 6543) prepared statements are disabled automatically.
DATABASE_URL=
DB_POOL_MAX_SIZE=5

# Only for `python -m tools.migrate_sqlite --email ...` (creates users via the Admin API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Path to Playwright Facebook session storage (created after manual login)
FB_STORAGE_STATE=fb_state.json

# Dedicated persistent Chrome profile for MercadoLibre (relative to repo root).
# Chrome must be installed; collection uses a visible browser, as in Tecc.
ML_BROWSER_PROFILE_DIR=.ml_chrome_profile

# Notifications (sección 7). Email is on when both are set.
RESEND_API_KEY=
EMAIL_FROM=
# The web (web/): tracked alert links /r/<id> and the links the bot sends.
# Local: http://127.0.0.1:3000. Telegram only shows its "Ver en Automotive"
# button for https URLs.
WEB_BASE_URL=
NOTIFY_TICK_SECONDS=60

# LLM layer (sección 8): the web's modo asistido. openai uses GPT-6 Luna
# through Responses with strict JSON Schema and reasoning disabled.
# The key belongs only here, on the worker; never in web/.env.local.
# claude_cli runs `claude -p`
# on this host (Claude Code installed and logged in); local is the future
# OpenAI-compatible server (stub for now: its jobs fail and the web falls back).
# anthropic: the Claude API with ANTHROPIC_API_KEY (the pilot, F7).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Empty: `claude` from PATH. On Windows, the full path to claude.exe.
CLAUDE_CLI_PATH=
CLAUDE_CLI_MODEL=haiku
# Budget per job, one retry included.
LLM_TIMEOUT_SECONDS=60
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=
LLM_POLL_SECONDS=2
LLM_CONCURRENCY=1
