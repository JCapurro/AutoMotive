# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone who chats with the bot.
ALLOWED_USER_IDS=

# How often the scheduler wakes up to look for alerts that need scraping.
TICK_INTERVAL_SECONDS=300

# Each alert is re-scraped at most once per this interval (default 21600 = 6h).
ALERT_RESCRAPE_INTERVAL_SECONDS=21600

# Recommended listings whose publication date is older than this are dropped.
# Sources without a reliable publication date use seen_listings + bootstrap.
RECOMMENDED_MAX_AGE_DAYS=15

# How many comparable listings are needed before computing a market median
OPPORTUNITY_MIN_COMPARABLES=5

# Default minimum discount vs median to flag as opportunity (percent)
DEFAULT_DISCOUNT_PCT=15

# Enable listing-location geocoding for radio_km filtering.
# Uses a local city table first, then Nominatim/OpenStreetMap with SQLite cache.
GEOCODING_ENABLED=1
GEOCODING_USER_AGENT=AutoMotiveAlerts/1.0

# Path to SQLite DB
DB_PATH=automotive.db

# Path to Playwright Facebook session storage (created after manual login)
FB_STORAGE_STATE=fb_state.json

# Path to Playwright MercadoLibre session storage (created after manual login)
ML_STORAGE_STATE=ml_state.json
